#!/bin/sh
# Test double for the GitHub CLI (`gh`). It never reaches the network.
#
# FAKE_GH_DIR names its control directory. When it is unset, the directory is
# `<directory of this script>/../gh`: the layout `tests/common/feedback.rs`
# (`FakeTools`) makes, so a test needs no process-wide variable.
#
# Every run appends "$*" as one line to `calls.log`, its environment to
# `env.log` and its working directory (physical) to `cwd.log`. Then:
#   - `fail` holds exactly "$1 $2": prints LEAK-gh-stdout to stdout and
#     LEAK-gh-stderr to stderr, and exits 1;
#   - `hang` holds exactly "$1 $2": writes its process id to `hang.pid` and
#     sleeps 600 s (as the same process);
#   - `wait` holds exactly "$1 $2": writes its process id to `wait.pid`,
#     waits until the file `go` exists (60 s at most), then goes on below;
#   - `auth status`: exits 1 when the file `signed-out` exists, else 0;
#   - `repo view`: prints the file `visibility-<name>` for the repository
#     `<owner>/<name>` its last argument names, else the file `visibility`,
#     else PRIVATE;
#   - `label list`: prints the file `label`, else true;
#   - `issue list`, `pr list`: print the file `existing`, else nothing; for
#     `pr list`, while the file `existing-head` exists, only when an
#     argument names its commit (as the `--jq` filter on `headRefOid` would);
#   - `issue create`: copies the file named by `--body-file=` to
#     `issue-body.md` and prints the file `issue-url`, else an issue URL;
#   - `pr create`: copies it to `pr-body.md` and prints a pull request URL;
#   - anything else exits 0.
dir="${FAKE_GH_DIR:-$(dirname "$0")/../gh}"
printf '%s\n' "$*" >> "$dir/calls.log"
env >> "$dir/env.log"
pwd -P >> "$dir/cwd.log"

holds() {
  [ -f "$dir/$1" ] && [ "$(cat "$dir/$1")" = "$2" ]
}

if holds fail "$1 $2"; then
  echo LEAK-gh-stdout
  echo LEAK-gh-stderr >&2
  exit 1
fi
if holds hang "$1 $2"; then
  printf '%s\n' "$$" > "$dir/hang.pid"
  exec sleep 600
fi
if holds wait "$1 $2"; then
  printf '%s\n' "$$" > "$dir/wait.pid"
  i=0
  while [ ! -f "$dir/go" ] && [ "$i" -lt 1200 ]; do
    sleep 0.05
    i=$((i + 1))
  done
fi

# Prints the file `$1` of the control directory, or `$2` when it is absent.
print_or() {
  if [ -f "$dir/$1" ]; then
    cat "$dir/$1"
  else
    printf '%s' "$2"
  fi
}

# Sets `body` to the path an argument `--body-file=<path>` names.
find_body() {
  body=""
  for a in "$@"; do
    case "$a" in
      --body-file=*) body="${a#--body-file=}" ;;
    esac
  done
}

case "$1 $2" in
  "auth status")
    [ -f "$dir/signed-out" ] && exit 1
    exit 0
    ;;
  "repo view")
    for a in "$@"; do last="$a"; done
    if [ -f "$dir/visibility-${last##*/}" ]; then
      cat "$dir/visibility-${last##*/}"
    else
      print_or visibility PRIVATE
    fi
    echo
    ;;
  "label list")
    print_or label true
    echo
    ;;
  "issue list")
    print_or existing ""
    ;;
  "pr list")
    if [ -f "$dir/existing-head" ]; then
      case "$*" in
        *"\"$(cat "$dir/existing-head")\""*) print_or existing "" ;;
      esac
    else
      print_or existing ""
    fi
    ;;
  "issue create")
    find_body "$@"
    cp "$body" "$dir/issue-body.md" || exit 1
    print_or issue-url "https://github.com/smithagents-test-invalid/widgets/issues/7"
    echo
    ;;
  "pr create")
    find_body "$@"
    cp "$body" "$dir/pr-body.md" || exit 1
    echo "https://github.com/smithagents-test-invalid/widgets/pull/8"
    ;;
esac
exit 0
